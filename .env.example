# =========================================================================
# BRING GIFT CARD — ENVIRONMENT VARIABLES
# =========================================================================
# Copy this file to `.env` (for local seed script) and to Vercel
# (Project Settings → Environment Variables) for production.
# =========================================================================

# ---- Neon Postgres connection string ----
# Get this from your Neon dashboard → Select project → Connection Details.
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Example: postgres://bringgiftcard:abc123@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---- JWT secret (used to sign admin session tokens) ----
# Generate a strong random string. Run this in your terminal:
#   openssl rand -base64 48
# Or use any 32+ character random string.
JWT_SECRET=replace-with-a-strong-random-string-at-least-32-chars

# =========================================================================
# HOW TO USE
# =========================================================================
# 1. LOCAL (for running `npm run seed`):
#    - Copy this file to `.env`
#    - Fill in the real values
#    - Run: npm install && npm run seed
#
# 2. PRODUCTION (Vercel):
#    - Push your code to GitHub (do NOT commit .env)
#    - Import the repo into Vercel
#    - In Project Settings → Environment Variables, add:
#        DATABASE_URL  = (your Neon connection string)
#        JWT_SECRET    = (your generated secret)
#    - Deploy. Done.
