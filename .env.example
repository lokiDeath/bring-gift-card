# ============================================================
# Bring Gift Card — Environment Variables
# Copy this file to `.env.local` for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# ============================================================

# ── Supabase (from your Supabase project: Settings → API) ──
# Public URL — safe to expose (used by the browser client).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon public key — safe to expose (RLS limits it to READ-only).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key — SECRET. Server-only. Bypasses RLS for admin writes.
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Admin login (defaults shown — override for extra safety) ──
# Login: bringgiftcard  /  Password: xuanjuanloki
# You can change these here without touching code.
ADMIN_USERNAME=bringgiftcard
ADMIN_PASSWORD=xuanjuanloki

# ── JWT signing secret for admin sessions ──
# Any long random string. Generate one: openssl rand -hex 32
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret-string
